# Copy to .env on the server -- never commit the result.
#
# Generate fresh values THERE rather than copying them from the dev machine, so
# a leaked development secret is worthless against the live site:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs the session cookie. Required whenever SITE_PASSWORD is set.
SECRET_KEY=

# Whole-site password gate. Leave empty in local development to disable it;
# always set it on the server.
SITE_PASSWORD=

# Bearer token for POST /api/recipes/ingest (phase 1) -- used by the Share
# Sheet shortcut, the bookmarklet, and later Hermes.
INGEST_TOKEN=

# Inside the container this is /app/data/dinner.db, bind mounted to ./data.
# An empty value here falls back to the same path, so a blank line is harmless.
DATABASE_PATH=/app/data/dinner.db

# How long a login lasts.
SESSION_DAYS=30
